#!/usr/bin/env bash
# Copy stdin locally or through the terminal when working on a headless devpod.
set -euo pipefail
emit_osc52() {
  # GNU and BSD base64 disagree about wrapping flags; stripping newlines is portable.
  printf '\033]52;c;%s\007' "$(base64 | tr -d '\r\n')"
}
case "${1:-}" in
  --emit) emit_osc52; exit ;; # Test/render OSC 52 without touching the clipboard.
  "") ;;
  *) printf 'Usage: dotfiles-copy [--emit] < text\n' >&2; exit 2 ;;
esac
if [[ -n ${TMUX:-} ]]; then
  # Let tmux send the escape sequence to its attached client, preserving its buffer.
  tmux load-buffer -w -
elif [[ -z ${SSH_CONNECTION:-} ]] && command -v pbcopy >/dev/null; then
  pbcopy
elif [[ -n ${WAYLAND_DISPLAY:-} ]] && command -v wl-copy >/dev/null; then
  wl-copy
elif [[ -n ${DISPLAY:-} ]] && command -v xclip >/dev/null; then
  xclip -selection clipboard
else
  emit_osc52 > /dev/tty
fi
