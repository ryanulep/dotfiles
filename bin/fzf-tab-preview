#!/usr/bin/env zsh
realpath="$1"

[[ -z "$realpath" ]] && exit 0

if [[ -d "$realpath" ]]; then
    tree -C -L 1 --filelimit 200 -I '.git|node_modules|target|bazel-*' -s -h -- "$realpath" \
        | perl -e '
            use utf8; binmode(STDIN, ":utf8"); binmode(STDOUT, ":utf8");
            my @lines; my $max = 0;
            while (<STDIN>) {
                s/\[ *(\d+)\]/[$1B]/g;
                push @lines, $_;
                $max = length($1) if /(\[\S+\])/ && length($1) > $max;
            }
            for (@lines) {
                s/(\[\S+\])/$1 . " " x ($max - length($1))/e;
                print;
            }'
elif [[ -f "$realpath" ]]; then
    # Bound work before parsing JSON, highlighting text, or decoding images.
    zmodload zsh/stat
    typeset -A file_info
    zstat -H file_info -- "$realpath" || exit 0
    if (( file_info[size] > 1048576 )); then
        printf 'Preview omitted: file exceeds 1 MiB (%s bytes).\n' "$file_info[size]"
        exit 0
    fi
    case "$realpath" in
        *.(jpg|jpeg|png|gif|bmp|webp|svg|ico))
            chafa "$realpath"
            ;;
        *.json|*.jsonc)
            jq --color-output . "$realpath" 2>/dev/null \
                || bat --color=always --paging=never --line-range=:200 -- "$realpath"
            ;;
        *)
            bat --color=always --paging=never --line-range=:200 -- "$realpath" 2>/dev/null
            ;;
    esac
fi
