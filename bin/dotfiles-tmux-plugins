#!/usr/bin/env bash
# Install every missing TPM dependency, then load the completed configuration.
set -euo pipefail
dotfiles_root="${DOTFILES:-$HOME/.dotfiles}"
plugin_dir="${TMUX_PLUGIN_MANAGER_PATH:-$HOME/.tmux/plugins/}"
tmux_conf="${TMUX_CONF:-$HOME/.tmux.conf}"

command -v tmux >/dev/null || { echo 'Install tmux first.' >&2; exit 1; }
if [[ ! -x "$plugin_dir/tpm/bin/install_plugins" ]]; then
  git -C "$dotfiles_root" submodule update --init --recursive link/.tmux/plugins/tpm
fi
if tmux list-sessions >/dev/null 2>&1; then
  tmux set-environment -g TMUX_PLUGIN_MANAGER_PATH "${plugin_dir%/}/"
  "$plugin_dir/tpm/bin/install_plugins"
  tmux source-file "$tmux_conf"
  printf 'All declared tmux plugins installed and configuration reloaded.\n'
else
  # TPM needs a live server for options. An empty default server exits between
  # commands, so use a temporary server without restoring sessions/processes.
  install_dir=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-tpm.XXXXXX")
  install_socket="$install_dir/socket"
  trap 'tmux -S "$install_socket" kill-server 2>/dev/null || true; rmdir "$install_dir" 2>/dev/null || true' EXIT
  tmux -S "$install_socket" -f /dev/null start-server \; \
    set-option -g exit-empty off \; \
    set-environment -g TMUX_PLUGIN_MANAGER_PATH "${plugin_dir%/}/"
  export TMUX="$install_socket,$$,0"
  "$plugin_dir/tpm/bin/install_plugins"
  printf 'All declared tmux plugins installed; ready for the next tmux start.\n'
fi
