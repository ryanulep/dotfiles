#!/usr/bin/env python3
"""Render/install an additive iTerm profile; preserve existing profiles."""
import argparse
import json
import os
from pathlib import Path
import plistlib
import sys
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--install", action="store_true")
parser.add_argument("--output", type=Path, help="write to a test/custom location")
args = parser.parse_args()
root = Path(__file__).resolve().parents[1]
profile = json.loads((root / "conf/iterm/Default.json").read_text())
profile["Name"] = "Dotfiles"
profile["Guid"] = "ryanulep-dotfiles"
# Merge the canonical theme assets instead of maintaining a second color palette.
for mode, theme in [("Light", "catppuccin-latte"), ("Dark", "catppuccin-mocha")]:
    colors = plistlib.loads((root / f"conf/iterm/{theme}.itermcolors").read_bytes())
    for name, value in colors.items():
        profile[f"{name} ({mode})"] = value
profile["Working Directory"] = str(Path.home())
document = json.dumps({"Profiles": [profile]}, indent=2) + "\n"
destination = args.output
if args.install:
    if sys.platform != "darwin":
        parser.error("iTerm profiles are only installed on macOS")
    destination = Path.home() / "Library/Application Support/iTerm2/DynamicProfiles/dotfiles.json"
if destination:
    destination.parent.mkdir(parents=True, exist_ok=True)
    # iTerm watches this directory: publish the whole JSON atomically.
    with tempfile.NamedTemporaryFile(mode="w", dir=destination.parent, delete=False) as stream:
        stream.write(document)
        temporary = stream.name
    os.replace(temporary, destination)
    print(f"Wrote {destination}")
else:
    print(document, end="")
