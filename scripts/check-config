#!/usr/bin/env bash
# Run from any directory on a laptop or devpod. Tests use temporary repositories
# and isolated tmux sockets; they never reload the user's tmux server.
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
for file in bin/dotfiles bin/dotfiles-tmux-plugins bin/dotfiles-copy init/*.sh scripts/eget.sh link/.tmux/*.sh config/ranger/scope.sh; do
  bash -n "$file"
done
for file in link/.zshrc source/*.sh config/ohmyzsh/custom/themes/*.zsh* bin/fzf-tab-preview; do
  zsh -n "$file"
done
if command -v shellcheck >/dev/null; then
  shellcheck bin/dotfiles-copy bin/dotfiles-tmux-plugins link/.tmux/resize-restored-windows.sh scripts/check-config
  shellcheck -s bash init/20_ubuntu_apt.sh init/30_osx_homebrew_recipes.sh init/40_cli.sh
fi
python3 -m unittest discover -s tests -v
git diff --check
